# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT authentication secret
JWT_SECRET=your_jwt_secret_key_here

# CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,https://yourdomain.com

# Node environment
NODE_ENV=development

# Server port
PORT=3002

# Paystack API secret key (for automated staff payments)
PAYSTACK_SECRET_KEY=

# Vercel environment flag (do not set locally)
# VERCEL=1
