# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT authentication secret (generate with: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here

# Admin setup key (generate with: node -e "console.log(require('crypto').randomUUID())")
ADMIN_FIX_KEY=your_admin_fix_key_here

# CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,https://yourdomain.com

# Node environment
NODE_ENV=development

# Server port
PORT=3002

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3001

# Paystack API secret key (for automated staff payments, optional)
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# Logging level (optional)
# LOG_LEVEL=info

# Error tracking (optional, for Sentry or similar)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

